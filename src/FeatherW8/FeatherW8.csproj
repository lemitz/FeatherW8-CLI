<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>FeatherW8</AssemblyName>
    <ApplicationIcon>$(MSBuildProjectDirectory)/../../icons/FeatherW8.ico</ApplicationIcon>
    <Version>0.2.0</Version>
    <RootNamespace>FeatherW8</RootNamespace>
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
    <PackageReference Include="NAudio.Asio" Version="3.1.0" />
    <PackageReference Include="NAudio.Vorbis" Version="3.0.0" />
    <PackageReference Include="Concentus.Oggfile" Version="1.0.7" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../FeatherW8.properties"
          Link="FeatherW8.properties"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
